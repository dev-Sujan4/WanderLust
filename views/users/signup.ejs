<% layout ("/layouts/boilerplate") %>

<div class="row mt-3">
    <h2 class="col-6 offset-3">Signup on WanderLust</h2>
    <div class="col-6 offset-3">
    
    <form action="/signup" method="POST" class="needs-validation" novalidate>
      

      <div class="mb-3">
        <label for="Email" class="form-label">Email</label>
        <input
          name="email"
          placeholder="Choose your email"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">You must enter an email.</div>
      </div>
      <div class="mb-3">
        <label for="Username" class="form-label">Username</label>
        <input
          name="username"
          placeholder="Choose your username"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">You must enter a username.</div>
      </div>
      <div class="mb-3">
        <label for="Password" class="form-label">Password</label>
        <input
          name="password"
          placeholder="Choose your password"
          type="password"
          class="form-control"
          required
        />
        <div class="invalid-feedback">You must enter a password.</div>
      </div>
      <button class="btn btn-dark">Create an account</button>
    </form>
    <br>
</div>
</div>