<% layout('/layouts/boilerplate') -%>

<div class="row mt-3">
  <div class="col-10 offset-1 col-lg-8 offset-lg-2 listing-wrapper">

    <div class="mx-auto" style="max-width: 700px;">
      <h3 class="mb-3"><%= listing.title %></h3>

      <div class="card show-card listing-card mb-4">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top show-img"
          alt="listing_image"
        />
        <div class="card-body">
          <p class="card-text fs-6">
            <%= listing.description %><br />
            &#8377;<%= listing.price.toLocaleString("en-IN") %><br />
            <%= listing.location %><br />
            <%= listing.country %>
          </p>
          <p class="card-text">
            <strong>Owner:</strong> <%= listing.owner.username %>
          </p>
        </div>
      </div>

      <% if (currUser && listing.owner.toString() === currUser.toString()) { %>
        <div class="btns mb-5 d-flex gap-2">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">
            Edit
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark">Delete</button>
          </form>
        </div>
      <% } %>
       
    </div>

    <hr />
    <h4>Leave a review</h4>
    <form
      action="/listings/<%= listing._id %>/reviews"
      method="POST"
      class="needs-validation"
      novalidate
    >
      <div class="mt-3">
        <label for="rating" class="form-label">Rating</label>
        <fieldset class="starability-basic">
          <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="rating" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="rating" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="rating" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="rating" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="rating" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>
      <div class="mb-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea
          name="comment"
          id="comment"
          cols="30"
          rows="5"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">You must enter a comment.</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>

    <hr />

    <% if (listing.reviews.length > 0) { %>
      <p><b>All reviews</b></p>
      <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
        <% for (let review of listing.reviews) { %>
          <div class="col">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="card-title mb-2 mt-2">@<%= review.author.username %></h5>
                <p class="starability-result" data-rating="<%= review.rating %>"></p>
                <p class="card-text"><%= review.comment %></p>
              </div>
              <% if (currUser && review.author.toString() === currUser.toString()) { %>
              <form class="mb-3 px-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-dark">Delete</button>
              </form>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>

    <h3>Where you'll be</h3>
    <div id="map" class="mb-4"></div>

  </div>
</div>

<script>
  window.mapsKey = "<%= process.env.MAPS_KEY %>";
  window.longitude = <%= longitude %>;
  window.latitude = <%= latitude %>;
</script>
<script src="/js/map.js"></script>